# Copie para .env e preencha. O .env nunca vai para o git. No servidor: chmod 600 .env

# Token do bot, criado no @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=

# Seu chat_id (número). O bot só responde a este chat e ignora o resto.
# Como descobrir: docs/deploy.md
TELEGRAM_CHAT_ID=

# Opcionais (valores padrão):
# INTERVAL_MIN=30     minutos entre rodadas (mínimo 5)
# REQ_MIN_MS=2000     pausa mínima entre requisições à Amazon
# REQ_MAX_MS=5000     pausa máxima
# DB_PATH=./data/tracker.db   (no Docker já é /data/tracker.db)
