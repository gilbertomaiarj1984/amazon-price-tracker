# Copie para .env e preencha. O .env nunca vai para o git. No servidor: chmod 600 .env

# Token do bot, criado no @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=

# Seu chat_id (número). O bot só responde a este chat e ignora o resto.
# Como descobrir: docs/deploy.md
TELEGRAM_CHAT_ID=

# Opcionais (valores padrão):
# INTERVAL_MIN=30     minutos entre rodadas (mínimo 5)
# REQ_MIN_MS=2000     pausa mínima entre requisições à Amazon
# REQ_MAX_MS=5000     pausa máxima
# DB_PATH=./data/tracker.db   (no Docker já é /data/tracker.db)

# Varredura diária de equivalentes: para itens em que a Amazon não vende, procura variações/edições que ela venda e sugere.
# SUGESTOES=0                  desliga
# SUGESTOES_HORA=4             hora (Brasília) a partir da qual roda, uma vez por dia
# SUGESTOES_MAX_ITENS=10       itens olhados por dia (os menos olhados primeiro)
# SUGESTOES_MAX_CANDIDATOS=4   variações conferidas por item
# SUGESTOES_PAUSA_MIN_MS=15000 / SUGESTOES_PAUSA_MAX_MS=30000   pausa entre requisições

# Painel web (lê e, por padrão, também altera: cadastrar, alvo, pausar, linhas, remover). Desligado se PANEL_PORT estiver vazio. Veja docs/painel.md.
# PANEL_PORT=8787
# PANEL_HOST=0.0.0.0
# Token só de leitura do selo do userscript (GET /api/selo/ASIN). Gere com: openssl rand -hex 24
# PANEL_READONLY=1   # desliga as ações de escrita do painel
# PANEL_TOKEN=
# USERSCRIPT_TOKEN=   # API do userscript com escrita (alvo/rastrear); openssl rand -hex 24, diferente do PANEL_TOKEN. Veja docs/userscript.md.
